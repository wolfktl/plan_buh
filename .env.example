# ---- Обязательно поменяйте перед запуском в проде ----

# Секрет для подписи сессий (JWT). Сгенерируйте: openssl rand -base64 48
SECRET_KEY=change-me-please-openssl-rand-base64-48

# Внешний порт, на котором будет доступно приложение
APP_PORT=8080

# Часовой пояс (для корректного времени напоминаний)
TZ=Europe/Moscow

# ---- PostgreSQL (сервис db в docker-compose) ----
POSTGRES_USER=planbuh
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=plan_buh
# Приложение внутри compose подключается к хосту db:5432 автоматически.
# Для внешней БД можно задать целиком DATABASE_URL (переопределяет POSTGRES_*):
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/plan_buh

# ---- Безопасность cookie ----
# true — отправлять cookie только по HTTPS. Включайте за reverse-proxy с TLS
# (nginx/traefik). Для локального http оставьте false.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# ---- 2FA ----
# Имя, которое увидит пользователь в приложении-аутентификаторе
TOTP_ISSUER=ПланБух

# ---- Сессии ----
SESSION_TTL_MIN=720     # срок жизни сессии после входа, минут (12 ч)
PREAUTH_TTL_MIN=5       # время на ввод кода 2FA, минут

# ---- SQLite (только для локального запуска без Docker) ----
# Используется, если не заданы ни DATABASE_URL, ни POSTGRES_HOST/USER.
DB_PATH=/data/plan_buh.db
